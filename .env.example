# Copy to a gitignored .env locally. Never commit secrets or certificate files.
# Used only by `bun run package:mac:proof`. Local `bun run package:mac` stays unsigned.

# Developer ID Application identity name as shown by `security find-identity -v -p codesigning`
# PHO_CODE_CODESIGN_IDENTITY=Developer ID Application: Example, Inc. (TEAMID)
# CSC_NAME is also accepted (electron-builder).

# PKCS#12 alternative to a Keychain identity (path + password stay outside git)
# CSC_LINK=/absolute/path/to/developer-id.p12
# CSC_KEY_PASSWORD=

# Notarization: App Store Connect API key (preferred) or Apple ID + app-specific password
# APPLE_API_KEY=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=
# APPLE_TEAM_ID=

# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=

# Optional monotonic CFBundleVersion for the proof artifact (not a public beta version)
# PHO_CODE_BUILD_NUMBER=1
